+/// Bytes before the resume offset that are hashed to detect a rewrite of
+/// already-ingested content (Claude Code tombstone removal, truncation, …).
+#[cfg(not(feature = "pg-backend"))]
+const TAIL_HASH_BYTES: u64 = 4096;
+
+#[cfg(not(feature = "pg-backend"))]
+fn read_tail(f: &mut fs::File, end: u64) -> Result<Vec<u8>> {
+    let start = end.saturating_sub(TAIL_HASH_BYTES);
+    let mut buf = vec![0u8; (end - start) as usize];
+    f.seek(SeekFrom::Start(start))?;
+    f.read_exact(&mut buf)?;
+    Ok(buf)
+}
+
+#[cfg(not(feature = "pg-backend"))]
+fn tail_hash(tail: &[u8]) -> String {
+    let tail = &tail[tail.len().saturating_sub(TAIL_HASH_BYTES as usize)..];
+    Sha256::digest(tail).iter().map(|b| format!("{:02x}", b)).collect()
+}
+
+/// One JSONL line → (ts, role, tool_name, content) as stored in msg, or None if the
+/// line is skipped (invalid UTF-8, empty, unparseable, empty content).
+#[cfg(not(feature = "pg-backend"))]
+fn parse_line(buf: &[u8]) -> Option<(String, String, Option<String>, String)> {
+    let raw = std::str::from_utf8(buf).ok()?;
+    if raw.is_empty() { return None; }
+    let rec: Value = serde_json::from_str(raw).ok()?;
+    let ts = rec.get("timestamp").and_then(|v| v.as_str())
+        .or_else(|| rec.get("ts").and_then(|v| v.as_str()))
+        .unwrap_or("")
+        .to_string();
+    let (role, tool_name, content) = flatten_content(&rec);
+    let trimmed = content.trim();
+    if trimmed.is_empty() { return None; }
+    Some((ts, role, tool_name, truncate_chars(trimmed, 200_000)))
+}
